<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BCom</RootNamespace>
    <AssemblyName>BCom</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <PublishTrimmed>false</PublishTrimmed>
    <UseAppHost>true</UseAppHost>
    <Version>2.1.0</Version>
    <ApplicationTitle>BCom</ApplicationTitle>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="System.IO.Ports" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="CrossPlatform/**/*.cs" />
    <AvaloniaResource Include="res/weixin.png" />
  </ItemGroup>
</Project>
